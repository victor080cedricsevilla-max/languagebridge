rules_version = '2';

// Language Bridge — Firestore security rules.
//
// Language modules and lessons ship inside the app and change only through app
// updates, so Firestore holds nothing but each signed-in user's own data.
// Every other path is denied by default.
//
// How to apply:
//   • Firebase console → Firestore Database → Rules → paste → Publish, OR
//   • firebase deploy --only firestore:rules   (Firebase CLI)

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user reads and writes only their own translation history.
    match /users/{userId}/history/{recordId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // One latest completed assessment per language, private to its learner.
    match /users/{userId}/assessments/{languageId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['score', 'total', 'completedAt'])
        && request.resource.data.score is int
        && request.resource.data.total is int
        && request.resource.data.total > 0
        && request.resource.data.total <= 10
        && request.resource.data.score >= 0
        && request.resource.data.score <= request.resource.data.total
        && request.resource.data.completedAt == request.time;
    }
  }
}
